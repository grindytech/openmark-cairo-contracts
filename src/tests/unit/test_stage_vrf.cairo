#[test]
fn withdraw_sales_works() {
    let id = 10;
    let commission = 500; // 5%
    let admin = setup_account(0x1);
    let mintAmount = 3;
    let (owner, buyer, stage, stage_address, _, payment_address) = setup_stage(
        id, StageType::Randomness, Option::None, [].span(), commission,
    );

    let payment_dispatcher = IERC20Dispatcher { contract_address: payment_address };
    let stage_dispatcher = IStageVRFDispatcher { contract_address: stage_address };
    let vrf_provider = IVrfProviderDispatcher {
        contract_address: stage_dispatcher.get_vrf_provider(),
    };

    start_cheat_caller_address(vrf_provider.contract_address, buyer);
    vrf_provider.request_random(stage_dispatcher.contract_address, Source::Nonce(buyer));
    stop_cheat_caller_address(vrf_provider.contract_address);

    start_cheat_caller_address(stage_address, buyer);
    stage_dispatcher.buy(mintAmount, [].span());
    stop_cheat_caller_address(stage_address);

    let sales = mintAmount * stage.price;
    let payout = sales - (sales * commission.into() / PERMYRIAD);
    let fee = sales - payout;
    let owner_balance = payment_dispatcher.balance_of(owner);
    let admin_balance = payment_dispatcher.balance_of(admin);

    let ownable_dispatcher = IOwnableDispatcher { contract_address: stage_address };
    start_cheat_caller_address(stage_address, owner);
    ownable_dispatcher.transfer_ownership(admin);
    stop_cheat_caller_address(stage_address);

    start_cheat_caller_address(stage_address, admin);
    let mut spy = spy_events();
    stage_dispatcher.withdrawSales();

    let expected_event = StageComponent::Event::SalesWithdrawn(
        SalesWithdrawn { owner: admin, tokenPayment: stage.payment, amount: payout },
    );
    spy.assert_emitted(@array![(stage_address, expected_event)]);

    assert(
        payment_dispatcher.balance_of(admin) == owner_balance + payout.into(),
        'seller balance incorrect',
    );
    assert(
        payment_dispatcher.balance_of(owner) == admin_balance + fee.into(),
        'seller balance incorrect',
    );
}

#[test]
#[should_panic(expected: ('OM: sold out',))]
fn buy_sold_out_panics() {
    let id = 10;
    let buyer2 = setup_account(BUYER2);

    let (_, buyer1, _, stage_address, _, payment_address) = setup_stage(
        id, StageType::Randomness, Option::None, [].span(), 0,
    );

    let payment_dispatcher = IERC20Dispatcher { contract_address: payment_address };
    let stage_dispatcher = IStageVRFDispatcher { contract_address: stage_address };
    let vrf_provider = IVrfProviderDispatcher {
        contract_address: stage_dispatcher.get_vrf_provider(),
    };

    start_cheat_caller_address(payment_address, buyer1);
    payment_dispatcher.approve(stage_address, 1000000);
    stop_cheat_caller_address(payment_address);

    start_cheat_caller_address(vrf_provider.contract_address, buyer1);
    vrf_provider.request_random(stage_dispatcher.contract_address, Source::Nonce(buyer1));
    stop_cheat_caller_address(vrf_provider.contract_address);

    start_cheat_caller_address(stage_address, buyer1);
    stage_dispatcher.buy(6, [].span());
    stop_cheat_caller_address(stage_address);

    start_cheat_caller_address(payment_address, buyer2);
    payment_dispatcher.approve(stage_address, 1000000);
    stop_cheat_caller_address(payment_address);

    start_cheat_caller_address(vrf_provider.contract_address, buyer2);
    vrf_provider.request_random(stage_dispatcher.contract_address, Source::Nonce(buyer2));
    stop_cheat_caller_address(vrf_provider.contract_address);

    start_cheat_caller_address(stage_address, buyer2);
    stage_dispatcher.buy(5, [].span()); // Exceeds maxAllocation (10)
}

